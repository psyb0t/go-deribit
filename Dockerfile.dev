# Development image for all Makefile-driven Go checks.
#
# Pins the Go 1.26.10 toolchain and carries the linter and security scanners, so
# `make lint`, `make test` and `make sec` run identically
# in a local shell and in CI (the pipeline runs every make target inside this
# image, so there is no host toolchain to drift).
FROM golang:1.26.10-trixie@sha256:e18951cff6896c16909458a8e0cbd52364a347826ff1f5b86d095fe0670d52e7

# The base image records the snapshot.debian.org timestamp it was built from.
# Installing from that snapshot ties every apt package to the base image digest,
# so the build never breaks when the live Debian mirrors move on.
RUN set -eu; \
	sources=/etc/apt/sources.list.d/debian.sources; \
	snapshot="$(grep -m1 -oE '[0-9]{8}T[0-9]{6}Z' "$sources")"; \
	test -n "$snapshot"; \
	sed -i -E "s|^URIs: http://deb.debian.org/(debian(-security)?)$|URIs: http://snapshot.debian.org/archive/\1/${snapshot}|" "$sources"; \
	apt-get -o Acquire::Retries=5 -o Acquire::Check-Valid-Until=false update; \
	apt-get install -y --no-install-recommends python3-venv xz-utils; \
	rm -rf /var/lib/apt/lists/*

# Security tools are pinned in the development image so local and CI scans use
# the same versions.
RUN go install golang.org/x/vuln/cmd/govulncheck@v1.6.0 \
	&& go install mvdan.cc/sh/v3/cmd/shfmt@v3.13.1

ARG TARGETARCH

RUN set -eu; \
	case "$TARGETARCH" in \
		amd64) \
			jq_sha256="b1c22172dd303f3be49e935aa56aa48a8b7a46e0bc838b4997d3bb451495870f"; \
			shellcheck_arch="x86_64"; \
			shellcheck_sha256="8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198" \
			;; \
		arm64) \
			jq_sha256="8b85c817833814ddca00a144c33705546355afccf0cf39b188f3cdb48b852309"; \
			shellcheck_arch="aarch64"; \
			shellcheck_sha256="12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588" \
			;; \
		*) exit 1 ;; \
	esac; \
	wget -q -O /usr/local/bin/jq \
		"https://github.com/jqlang/jq/releases/download/jq-1.8.2/jq-linux-${TARGETARCH}"; \
	echo "${jq_sha256}  /usr/local/bin/jq" | sha256sum -c -; \
	chmod 0755 /usr/local/bin/jq; \
	wget -q -O /tmp/shellcheck.tar.xz \
		"https://github.com/koalaman/shellcheck/releases/download/v0.11.0/shellcheck-v0.11.0.linux.${shellcheck_arch}.tar.xz"; \
	echo "${shellcheck_sha256}  /tmp/shellcheck.tar.xz" | sha256sum -c -; \
	tar -xJf /tmp/shellcheck.tar.xz -C /usr/local/bin --strip-components=1 shellcheck-v0.11.0/shellcheck; \
	rm /tmp/shellcheck.tar.xz

RUN set -eu; \
	case "$TARGETARCH" in \
		amd64) \
			gitleaks_arch="x64"; \
			gitleaks_sha256="79a3ab579b53f71efd634f3aaf7e04a0fa0cf206b7ed434638d1547a2470a66e" \
			;; \
		arm64) \
			gitleaks_arch="arm64"; \
			gitleaks_sha256="b4cbbb6ddf7d1b2a603088cd03a4e3f7ce48ee7fd449b51f7de6ee2906f5fa2f" \
			;; \
		*) exit 1 ;; \
	esac; \
	wget -q -O /tmp/gitleaks.tar.gz \
		"https://github.com/gitleaks/gitleaks/releases/download/v8.30.0/gitleaks_8.30.0_linux_${gitleaks_arch}.tar.gz"; \
	echo "${gitleaks_sha256}  /tmp/gitleaks.tar.gz" | sha256sum -c -; \
	tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks; \
	rm /tmp/gitleaks.tar.gz

COPY requirements-semgrep.txt /tmp/requirements-semgrep.txt

# A virtual environment keeps semgrep's dependencies apart from the Python
# packages Debian manages.
RUN python3 -m venv /opt/semgrep \
	&& /opt/semgrep/bin/pip install \
		--disable-pip-version-check \
		--no-cache-dir \
		--require-hashes \
		-r /tmp/requirements-semgrep.txt \
	&& ln -s /opt/semgrep/bin/semgrep /usr/local/bin/semgrep

WORKDIR /work

CMD ["bash"]
